    <string name="permission_screen_capture_body">Only message notifications from WhatsApp and WhatsApp Business. Notifications from other apps are completely ignored.</string>
    <string name="permission_screen_storage_title">Stored Only On Your Device</string>
    <string name="permission_screen_storage_body">Messages are stored encrypted on your phone. Zero cloud storage, zero tracking. With the on-device AI, nothing ever leaves your phone.</string>
